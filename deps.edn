{:paths
 ["src/main"
  "src/resources"]

 :deps
 {io.pedestal/pedestal.service   {:mvn/version "0.8.1"}
  io.pedestal/pedestal.route     {:mvn/version "0.8.1"}
  io.pedestal/pedestal.jetty     {:mvn/version "0.8.1"}
  org.clojure/tools.analyzer     {:mvn/version "1.2.2"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.38"}
  com.stuartsierra/component     {:mvn/version "1.2.0"}
  com.datomic/client-cloud       {:mvn/version "1.0.137"}}

 :aliases
 {:dev
  {:extra-paths
   ["dev"]
   :jvm-opts
   ["-Dio.pedestal.dev-mode=true"]
   :extra-deps
   {com.datomic/local          {:mvn/version "1.0.301"}
    com.stuartsierra/component.repl {:mvn/version "1.0.0"}}}

  :test
  {:extra-paths
   ["dev"
    "src/test"]
   :extra-deps
   {com.datomic/local {:mvn/version "1.0.301"}
    com.stuartsierra/component.repl {:mvn/version "1.0.0"}}}}}
